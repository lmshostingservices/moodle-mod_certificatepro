{{!
    @template mod_certificatepro/ornament_picker

    The bundled public domain ornament picker.

    The catalogue is populated by an import step, so a source checkout ships the
    manifest with nothing in it. That is an ordinary state, not a failure, and
    the picker says so plainly instead of showing an empty grid.

    Context variables required for this template:
    * items - the matching ornaments, each with id, title, role, style, licence,
      source, attribution and svg
    * roles - the role facets, each with role, name, count and selected
    * total - how many ornaments are bundled in total
    * libraryempty - whether nothing is bundled at all
    * hasitems - whether the current filter matched anything

    Example context (json):
    {
        "total": 0,
        "libraryempty": true,
        "hasitems": false,
        "roles": [{"role": "border", "name": "Borders", "count": 0, "selected": false}],
        "items": []
    }
}}
<div class="cpro-library cpro-ornaments" data-region="ornamentpicker">
    {{#libraryempty}}
        <div class="cpro-emptystate" data-region="empty">
            <i class="fa fa-box-open fa-2x" aria-hidden="true"></i>
            <h4>{{#str}} ornamentemptytitle, mod_certificatepro {{/str}}</h4>
            <p>{{#str}} ornamentemptybody, mod_certificatepro {{/str}}</p>
            <p class="text-muted small">{{#str}} ornamentemptyhint, mod_certificatepro {{/str}}</p>
        </div>
    {{/libraryempty}}

    {{^libraryempty}}
        <p class="cpro-library-lede">{{#str}} ornamentintro, mod_certificatepro {{/str}}</p>

        <div class="cpro-facets" role="group" aria-label="{{#str}} ornamentroles, mod_certificatepro {{/str}}">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-action="role" data-value="" aria-pressed="true">
                {{#str}} ornamentallroles, mod_certificatepro {{/str}}
            </button>
            {{#roles}}
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-action="role" data-value="{{role}}" aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}"
                        {{^count}}disabled{{/count}}>{{name}} ({{count}})</button>
            {{/roles}}
        </div>

        <div class="cpro-facets">
            <label class="visually-hidden" for="cpro-ornament-search">{{#str}} ornamentsearch, mod_certificatepro {{/str}}</label>
            <input type="search" class="form-control form-control-sm cpro-search"
                   id="cpro-ornament-search" data-region="search"
                   placeholder="{{#str}} ornamentsearch, mod_certificatepro {{/str}}">
            <label class="visually-hidden" for="cpro-ornament-orientation">{{#str}} ornamentorientation, mod_certificatepro {{/str}}</label>
            <select class="form-select form-select-sm" id="cpro-ornament-orientation" data-region="orientation">
                <option value="">{{#str}} ornamentanyorientation, mod_certificatepro {{/str}}</option>
                <option value="L">{{#str}} ornamentlandscape, mod_certificatepro {{/str}}</option>
                <option value="P">{{#str}} ornamentportrait, mod_certificatepro {{/str}}</option>
            </select>
        </div>

        <div class="cpro-gallery" role="listbox"
             aria-label="{{#str}} ornamentlabel, mod_certificatepro {{/str}}" data-region="gallery" tabindex="0">
            {{#items}}
                <div class="cpro-gallery-item" role="option" tabindex="-1" aria-selected="false"
                     id="cpro-orn-{{id}}" data-region="tile" data-value="{{id}}">
                    <div class="cpro-ornthumb" aria-hidden="true">{{{svg}}}</div>
                    <div class="cpro-gallery-caption">
                        <span class="cpro-gallery-name">{{title}}</span>
                        <span class="cpro-gallery-mood">{{source}} &middot; {{licence}}</span>
                        {{#attribution}}
                            <span class="cpro-gallery-warning">{{#str}} ornamentcredit, mod_certificatepro {{/str}}</span>
                        {{/attribution}}
                    </div>
                </div>
            {{/items}}
        </div>

        {{^hasitems}}
            <div class="cpro-emptystate" data-region="nomatches">
                <p>{{#str}} ornamentnomatches, mod_certificatepro {{/str}}</p>
            </div>
        {{/hasitems}}

        <div class="cpro-library-actions">
            <p class="cpro-library-note" data-region="note" role="status" aria-live="polite"></p>
            <button type="button" class="btn btn-primary" data-action="apply" disabled>
                {{#str}} ornamentplace, mod_certificatepro {{/str}}
            </button>
        </div>
    {{/libraryempty}}
</div>
